A builtin:fetchurl of an s3:// URL can deadlock the daemon's builder.
`preResolveAwsCredentials` (`derivation-builder.cc:622`) runs the AWS
credential chain in the daemon worker, which leaves AWS CRT event-loop
threads running there. The worker then forks the builder, and the builder
waits forever on a mutex that one of those threads held at the fork.
Measured in the pynixd guests: worker with 8 threads in `epoll_wait`,
builder with two threads in `futex_wait`, about once a day under load.
The chain runs in a process of its own here, so the builder forks from a
worker that never started those threads. Lillecarl/nix#424,
nixidae/nixidae#1283.

--- a/src/libstore/unix/build/derivation-builder.cc
+++ b/src/libstore/unix/build/derivation-builder.cc
@@ -619,6 +619,46 @@
 }

 #if NIX_WITH_AWS_AUTH
+/* The credential chain starts AWS CRT event-loop threads that outlive the
+   call. A builder forked after them inherits each mutex one of them held at
+   the fork, and can wait on it forever. So the chain runs in a process of
+   its own, and the builder forks from a process that never started them. */
+static AwsCredentials resolveAwsCredentialsInChild(const ParsedS3URL & s3Url)
+{
+    Pipe result;
+    result.create();
+
+    Pid pid = startProcess([&]() {
+        result.readSide.close();
+        /* A daemon worker's logger writes to the client's connection. */
+        logger = makeSimpleLogger().release();
+        std::string reply;
+        try {
+            auto credentials = getAwsCredentialsProvider()->getCredentials(s3Url);
+            reply = "1" + credentials.accessKeyId + '\0' + credentials.secretAccessKey + '\0'
+                    + (credentials.sessionToken ? "1" + *credentials.sessionToken : "0");
+        } catch (const std::exception & e) {
+            reply = std::string("0") + e.what();
+        }
+        writeFull(result.writeSide.get(), reply);
+        _exit(0);
+    });
+
+    result.writeSide.close();
+    auto reply = drainFD(result.readSide.get());
+    if (auto status = pid.wait(); !statusOk(status))
+        throw Error("the process that resolves AWS credentials %s", statusToString(status));
+    if (reply.empty() || reply[0] != '1')
+        throw Error("%s", reply.empty() ? "no reply" : reply.substr(1));
+    auto fields = splitString<std::vector<std::string>>(std::string_view(reply).substr(1), std::string_view("\0", 1));
+    if (fields.size() != 3 || fields[2].empty())
+        throw Error("malformed reply");
+    return AwsCredentials(
+        fields[0],
+        fields[1],
+        fields[2][0] == '1' ? std::optional<std::string>(fields[2].substr(1)) : std::nullopt);
+}
+
 std::optional<AwsCredentials> DerivationBuilderImpl::preResolveAwsCredentials()
 {
     if (drv.isBuiltin() && drv.builder == "builtin:fetchurl") {
@@ -630,9 +670,8 @@
